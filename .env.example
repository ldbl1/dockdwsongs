# dwSongs example environment file
# Copy this file to .env and adjust values for your deployment.
# Do NOT commit .env to GitHub.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_NAME=dwSongs
APP_ENV=production
TZ=Europe/Madrid

# -----------------------------------------------------------------------------
# Paths inside the container
# -----------------------------------------------------------------------------

# Where dwSongs stores its runtime configuration.
CONFIG_PATH=/config

# Where dwSongs stores temporary/incoming downloads.
DOWNLOADS_PATH=/downloads

# Where dwSongs writes organized music for Jellyfin.
# This path must match the volume mounted in docker-compose.yml.
LIBRARY_MUSIC_PATH=/library/music

# -----------------------------------------------------------------------------
# Jellyfin
# -----------------------------------------------------------------------------

# Examples:
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_URL=http://host.docker.internal:8096
# JELLYFIN_URL=http://192.168.1.50:8096
JELLYFIN_URL=

# Create this API key from Jellyfin admin dashboard.
JELLYFIN_API_KEY=

# If true, dwSongs will try to refresh Jellyfin after sending music to library.
AUTO_REFRESH_JELLYFIN=true

# -----------------------------------------------------------------------------
# Optional defaults
# -----------------------------------------------------------------------------

# Default interface language. Available languages are loaded from app/i18n/*.json.
LANGUAGE=es

# Default audio format used by the UI unless changed in the browser.
DEFAULT_AUDIO_FORMAT=mp3
